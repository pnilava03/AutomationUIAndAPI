<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Opencart App Test Smoke Suite" verbose="4" parallel="tests" thread-count="6">

<!--    <listeners>-->
<!--        <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener"/>-->
<!--    </listeners>-->

    <test name="Login Page Test_Smoke_Firefox">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="com.qa.opencart.Runner.TestRunnerSmoke" />
        </classes>
    </test>

    <test name="Login Page Test_Smoke_Chrome">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="com.qa.opencart.Runner.TestRunnerSmoke" />
        </classes>
    </test>


    <test name="Login Page Test_Smoke_Edge">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="com.qa.opencart.Runner.TestRunnerSmoke" />
        </classes>
    </test>



</suite>